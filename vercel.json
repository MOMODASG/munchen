{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "buildCommand":  "node build-site.mjs",
    "outputDirectory":  "dist",
    "proxy":  {
                  "entrypoint":  "proxy.js",
                  "matcher":  [
                                  "/",
                                  "/index.php",
                                  "/de",
                                  "/de/:path*",
                                  "/admin/:path*"
                              ]
              },
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        }
                                    ],
                        "source":  "/(.*)"
                    }
                ]
}